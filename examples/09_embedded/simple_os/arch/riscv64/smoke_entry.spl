extern fn serial_println(msg: text)
extern fn rt_qemu_exit_success()
extern fn rt_qemu_exit_failure()
extern fn rt_riscv_nvfs_probe() -> i64
extern fn rt_sosix_collector_nonce_echo() -> i64
extern fn rt_riscv_smf_cli_probe() -> i64
extern fn rt_riscv_smf_cli_load() -> i64
extern fn rt_riscv_smf_gui_probe() -> i64
extern fn rt_riscv_native_gui_process_render() -> i64
extern fn rt_riscv_harden_canary_value() -> i64
extern fn rt_riscv_fs_exec_probe() -> i64
extern fn rt_riscv_fs_exec_run() -> i64
extern fn rt_riscv_fs_legacy_exec_disabled() -> i64
extern fn rt_riscv_fs_list_apps() -> i64
extern fn rt_riscv_fs_exec_malformed_selftest() -> i64
extern fn rt_riscv_fs_exec_privilege_selftest() -> i64
extern fn rt_riscv_fs_reaped_generation() -> i64
extern fn rt_riscv_fs_reap_auth_ok() -> i64
extern fn rt_riscv_fs_last_trap_cause() -> i64
extern fn rt_riscv_fs_last_trap_sepc() -> i64
extern fn rt_riscv_fs_last_trap_stval() -> i64
use os.services.vfs.vfs_boot_init.{vfs_boot_init_riscv64_virtio_fat32, g_mount_table}
use os.kernel.loader.riscv64_authenticated_media_fixture.{riscv64_authenticated_media_acceptance_v1}
use os.kernel.scheduler.scheduler_types.{Scheduler}

fn spl_start():
    serial_println("")
    serial_println("=== SimpleOS RV64 smoke boot ===")
    serial_println("SimpleOS RV64 boot OK")
    serial_println("[harden] canary arch=riscv64 value=" + rt_riscv_harden_canary_value().to_text())
    if rt_riscv_nvfs_probe():
        serial_println("[riscv-nvfs] image read ok")
    else:
        serial_println("[riscv-nvfs] image read failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    if rt_sosix_collector_nonce_echo() != 1:
        serial_println("[riscv64-collector-nonce] target media read failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    serial_println("guest-entry")
    if rt_riscv_smf_cli_probe():
        serial_println("FS_MOUNT_OK")
        serial_println("SMF_DISCOVERY_OK")
    else:
        serial_println("[riscv-smf] cli launch probe failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    if rt_riscv_smf_cli_load():
        serial_println("ELF_LOAD_OK arch=riscv64 app=/sys/apps/hello_world.smf")
        serial_println("SMF_CLI_LAUNCH_OK app=/sys/apps/hello_world.smf")
    else:
        serial_println("[riscv-smf] cli elf load failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    if rt_riscv_smf_gui_probe():
        serial_println("[riscv-smf] gui package found app=/sys/apps/browser_demo.smf")
    else:
        serial_println("[riscv-smf] wm gui launch probe failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    if rt_riscv_native_gui_process_render():
        serial_println("SMF_WM_GUI_LAUNCH_OK app=/sys/apps/browser_demo.smf pid=1002 wm=x86_64_desktop_shell_contract")
        serial_println("NATIVE_GUI_PROCESS_RENDER_OK app=/sys/apps/browser_demo.smf pid=1002")
    else:
        serial_println("[riscv-smf] native gui process render failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    val fs_exec_present = rt_riscv_fs_exec_probe()
    val fs_listing_count = rt_riscv_fs_list_apps()
    val malformed_rejected = rt_riscv_fs_exec_malformed_selftest()
    val privilege_rejected = rt_riscv_fs_exec_privilege_selftest()
    if not malformed_rejected:
        serial_println("[riscv-fs-exec] malformed admission selftest failed")
    if not privilege_rejected:
        serial_println("[riscv-fs-exec] privilege/state restoration selftest failed")
    if not fs_exec_present or fs_listing_count <= 0 or not malformed_rejected or not privilege_rejected:
        serial_println("[riscv-fs-exec] payload lookup failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    serial_println("RV64_ELF_ADMISSION_NEGATIVE_OK")
    serial_println("RV64_USER_ISOLATION_OK write_fault_cause=15")
    serial_println("RV64_SUPERVISOR_STATE_RESTORE_OK")
    # `/FSEXEC.ELF` is writable boot media and has no canonical loader-issued
    # authority token.  Keep its parser/isolation checks as structural evidence,
    # but never enter it from the production boot path.
    if not rt_riscv_fs_legacy_exec_disabled():
        serial_println("[riscv-fs-exec] unauthenticated legacy execution enabled")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    serial_println("RV64_LEGACY_FSEXEC_DISABLED reason=missing-loader-authority-token")
    if not vfs_boot_init_riscv64_virtio_fat32() or
       not riscv64_authenticated_media_acceptance_v1(Scheduler.new(), g_mount_table):
        serial_println("[riscv-auth-exec] canonical loader fixture failed")
        serial_println("TEST FAILED")
        rt_qemu_exit_failure()
        return
    serial_println("SIMPLEOS_RISCV_SMF_FS_PASS")
    serial_println("TEST PASSED")
    rt_qemu_exit_success()
