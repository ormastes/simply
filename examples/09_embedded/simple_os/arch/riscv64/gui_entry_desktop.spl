# codex-impl
# Canonical RV64 production desktop over dynamic VirtIO-GPU scanout.

use os.kernel.arch.riscv64.display.{
    riscv64_display_boot_memory_initialize,
    riscv64_display_initialize,
    riscv64_display_framebuffer_address,
    riscv64_display_width,
    riscv64_display_height,
    riscv64_display_pitch,
    riscv64_display_bpp,
    riscv64_display_generation,
    riscv64_display_present
}
use os.drivers.framebuffer.fb_driver.{FramebufferDriver}
use os.compositor.compositor.{Compositor}
use os.compositor.arm64_virtio_input_backend.{Arm64VirtioInputBackend}
use os.compositor.compositor_engine2d.{Engine2dCompositorBackend}
use os.compositor.engine2d_display.{create_fb_engine_sized}
use os.compositor.engine2d_wm_frame_executor.{Engine2dWmFrameExecutor}
use os.compositor.simpleos_wm_theme_bootstrap.{install_generated_simpleos_wm_theme, apply_simpleos_css_theme_override}
use os.desktop.shell.{DesktopShell}
use os.desktop.font_bootstrap.{simpleos_desktop_register_selected_fonts_from_vfs}
use os.services.vfs.vfs_init.{vfs_boot_init_riscv64_virtio_fat32, g_vfs_read_file_text}
use os.kernel.arch.riscv64.console.{serial_init, serial_read_byte}
use os.gui.input_event.{WmAction}
use os.gui.shortcut.{uart_char_to_action}
use os.drivers.input.ps2_keyboard.{Key, KeyEvent}
use os.kernel.arch.riscv64.virtio_input.{
    riscv64_virtio_input_init,
    riscv64_virtio_input_poll,
    riscv64_virtio_input_ready
}
use os.kernel.ipc.host_gpu_ivshmem_map.{
    map_qemu_host_gpu_ivshmem_bar2,
    qemu_host_gpu_ivshmem_window_base
}
use os.kernel.boot.monotonic_hardware.{boot_monotonic_prepare, boot_monotonic_now_us}
use common.gpu.simpleos_host_gpu_protocol.{
    SIMPLEOS_HOST_GPU_BACKEND_METAL,
    SIMPLEOS_HOST_GPU_ISA_RISCV64
}

extern fn serial_println(msg: text)
extern fn __simple_call_module_inits()

fn rv64_wm_action_from_virtio_key(event: KeyEvent) -> WmAction:
    match event:
        KeyEvent.Release(_key): WmAction.None
        KeyEvent.Press(key):
            match key:
                Key.Tab: WmAction.CycleFocus
                Key.Num1: WmAction.FocusWindow(idx: 0u64)
                Key.Num2: WmAction.FocusWindow(idx: 1u64)
                Key.Num3: WmAction.FocusWindow(idx: 2u64)
                Key.Q: WmAction.Quit
                Key.M: WmAction.Minimize
                Key.W: WmAction.Close
                Key.R: WmAction.Restore
                Key.T: WmAction.ToggleTheme
                _: WmAction.None

fn boot_main(hart_id: u64, dtb_addr: u64):
    val _hart_id = hart_id
    val _dtb_addr = dtb_addr
    serial_println("[desktop-gui-riscv64] boot")

    if not riscv64_display_boot_memory_initialize():
        serial_println("[desktop-gui-riscv64] fatal reason=display-memory")
        return
    __simple_call_module_inits()
    serial_init()
    val theme_snapshot = install_generated_simpleos_wm_theme()
    serial_println("[theme-evidence] id={theme_snapshot.id} source_manifest_sha256={theme_snapshot.source_manifest_sha256} material_sha256={theme_snapshot.material_sha256} backdrop_filter=unavailable fallback=solid-material")
    if not riscv64_display_initialize():
        serial_println("[desktop-gui-riscv64] fatal reason=scanout-init")
        return

    val width = riscv64_display_width()
    val height = riscv64_display_height()
    val pitch = riscv64_display_pitch()
    val bpp = riscv64_display_bpp()
    val address = riscv64_display_framebuffer_address()
    if address == 0u64 or width == 0u32 or height == 0u32 or pitch != width * 4u32 or bpp != 32u32:
        serial_println("[desktop-gui-riscv64] fatal reason=scanout-metadata")
        return
    serial_println("[desktop-gui-riscv64] scanout-ready width={width} height={height} stride={pitch}")
    val screen_w = width.to_i64()
    val screen_h = height.to_i64()

    val vfs_mounted = vfs_boot_init_riscv64_virtio_fat32()
    if not vfs_mounted:
        serial_println("[desktop-gui-riscv64] fatal reason=font-media-mount")
        return
    val theme_css = g_vfs_read_file_text("/THEME.CSS")
    val theme_override_applied = apply_simpleos_css_theme_override(theme_css)
    serial_println("[theme-override] path=/THEME.CSS mount={vfs_mounted} bytes={theme_css.len()} applied={theme_override_applied}")
    if not simpleos_desktop_register_selected_fonts_from_vfs():
        serial_println("[desktop-gui-riscv64] fatal reason=font-register")
        return
    serial_println("[rv64-font-evidence] guest_path=/SYS/FONTS/NOTOSANS asset_bytes=1708408 asset_sha256=2cb2adb378a8f574213e23df697050b83c54c27df465a2015552740b2769a081 route=shared-wm-draw-ir component_id=taskbar-clock")

    var framebuffer = FramebufferDriver.from_scanout_raw(address, width, height, pitch, bpp)
    var engine = create_fb_engine_sized(framebuffer, width.to_i32(), height.to_i32())
    val compositor_backend = Engine2dCompositorBackend.create(engine)
    var input_backend = Arm64VirtioInputBackend.create_with_poller(
        screen_w,
        screen_h,
        riscv64_virtio_input_poll
    )
    var compositor = Compositor.with_backends(
        compositor_backend, input_backend, width.to_i32(), height.to_i32()
    )

    val terminal_id = compositor.compositor_materialize_process_surface_scalar(
        "Terminal", (screen_w / 20).to_i32(), (screen_h / 8).to_i32(),
        (screen_w * 9 / 20).to_i32(), (screen_h * 2 / 5).to_i32(),
        0, "terminal", "<pre>simple$ uname -m\nriscv64\nsimple$ simple check\nAll checks passed\nsimple$</pre>"
    )
    val editor_id = compositor.compositor_materialize_process_surface_scalar(
        "Editor", (screen_w * 7 / 20).to_i32(), (screen_h / 4).to_i32(),
        (screen_w / 2).to_i32(), (screen_h / 2).to_i32(),
        0, "editor", "<pre>fn main():\n    val x = 42\n    print x\n\n# Comment\nfn square(n):\n    n * n</pre>"
    )
    val finder_id = compositor.compositor_materialize_process_surface_scalar(
        "Finder", (screen_w * 3 / 5).to_i32(), (screen_h * 3 / 5).to_i32(),
        (screen_w * 7 / 20).to_i32(), (screen_h * 3 / 10).to_i32(),
        0, "finder", "<h2>Favorites</h2><p>Desktop</p><p>Documents</p><p>Downloads</p><h3>Project</h3><p>Photos</p>"
    )
    if terminal_id <= 0 or editor_id <= 0 or finder_id <= 0:
        serial_println("[desktop-gui-riscv64] fatal reason=surface-materialization")
        return
    compositor.focus_window(editor_id.to_i32())

    var shell = DesktopShell.new(compositor)
    shell.init_baremetal()

    boot_monotonic_prepare()
    val mapped_slot = map_qemu_host_gpu_ivshmem_bar2()
    val host_gpu_base = qemu_host_gpu_ivshmem_window_base(mapped_slot)
    val negotiation_started_us = boot_monotonic_now_us()
    # RV64 has no admitted native SIMD fill capability/runtime receipt yet.
    var executor = Engine2dWmFrameExecutor.create(engine, framebuffer, 0, 0, false)
    if host_gpu_base != 0u64:
        executor = Engine2dWmFrameExecutor.create_host_gpu(
            engine, framebuffer, host_gpu_base,
            SIMPLEOS_HOST_GPU_ISA_RISCV64,
            SIMPLEOS_HOST_GPU_BACKEND_METAL,
            0, 0, negotiation_started_us, false,
            # `backend_required` passed EXPLICITLY -- an omitted trailing default
            # is not materialized under native/baremetal codegen and the callee
            # reads an uninitialized slot. Same defect that broke the x86_64 lane.
            # doc/08_tracking/bug/native_trailing_default_param_reads_uninitialized_2026-08-09.md
            false
        )

    val revision = shell.render_baremetal_first_frame(executor)
    if revision <= 0:
        serial_println("[desktop-gui-riscv64] fatal reason=first-frame")
        return
    if not riscv64_display_present():
        serial_println("[desktop-gui-riscv64] fatal reason=scanout-present")
        return

    val display_generation = riscv64_display_generation()
    if display_generation <= 0:
        serial_println("[desktop-gui-riscv64] fatal reason=scanout-generation")
        return
    serial_println("[desktop-gui-riscv64] scanout-present address={address} width={width} height={height} stride={pitch} bpp={bpp} format=bgra8888 generation={display_generation} scene_revision={revision}")
    serial_println("[desktop-gui-riscv64] present-ok revision={revision}")
    serial_println("[desktop-gui-riscv64] desktop-ready revision={revision}")
    serial_println("[backend-evidence] present=virtio-gpu-transfer+flush source=shared-wm-draw-ir-engine2d")
    val virtio_input_mask = riscv64_virtio_input_init()
    val virtio_input_enabled = riscv64_virtio_input_ready(virtio_input_mask)
    if virtio_input_enabled:
        serial_println("[rv64-input] transport=virtio-pci keyboard=ready pointer=ready queue=eventq0 delivery=poll+irq-ack+refill")
    else:
        serial_println("[rv64-input-evidence-unavailable] reason=virtio-input-device-not-ready ready_mask={virtio_input_mask} required_transport=qmp-input-send-event required_correlation=guest-irq+wm-state+frame")
    serial_println("TEST PASSED")
    serial_println("SIMPLEOS_RISCV_DISPLAY_SMOKE_READY")
    serial_println("[desktop-gui-riscv64] controls Tab=cycle 1/2/3=focus m=minimize w=close r=restore q=quit")

    var running = true
    var observed_key_sequence: i64 = 0
    var observed_pointer_sequence: i64 = 0
    while running:
        var input_compositor = shell.compositor
        var action = WmAction.None
        var action_name = "none"
        var changed = false
        var key_event_pending = false
        var key_sequence: i64 = 0
        var key_code: u16 = 0u16
        var key_value: u32 = 0u32
        var pointer_event_pending = false
        var pointer_sequence: i64 = 0
        var pointer_x: i32 = 0
        var pointer_y: i32 = 0
        var pointer_button_code: i32 = 0
        var pointer_kind_code: i32 = 0

        if virtio_input_enabled:
            input_compositor.handle_input()
            if input_backend.delivered_key_sequence > observed_key_sequence:
                observed_key_sequence = input_backend.delivered_key_sequence
                key_sequence = observed_key_sequence
                key_code = input_backend.delivered_key_code
                key_value = input_backend.delivered_key_value
                serial_println("[virtio-input-device] input_seq={key_sequence} device=keyboard type=1 code={key_code} value={key_value} irq_status={input_backend.delivered_key_irq_status}")
                if val key_event = input_backend.delivered_key:
                    action = rv64_wm_action_from_virtio_key(key_event)
                    key_event_pending = (
                        key_value != 0u32 and
                        input_backend.delivered_key_irq_status != 0u32
                    )
            if input_backend.delivered_mouse_sequence > observed_pointer_sequence:
                observed_pointer_sequence = input_backend.delivered_mouse_sequence
                pointer_sequence = observed_pointer_sequence
                pointer_event_pending = (
                    input_backend.delivered_pointer_irq_status != 0u32 and
                    input_compositor.pending_wm_pointer_valid
                )
                pointer_x = input_compositor.pending_wm_pointer_x
                pointer_y = input_compositor.pending_wm_pointer_y
                pointer_button_code = input_compositor.pending_wm_pointer_button_code
                pointer_kind_code = input_compositor.pending_wm_pointer_kind_code
                serial_println("[virtio-input-device] input_seq={pointer_sequence} device=pointer type={input_backend.delivered_pointer_type} code={input_backend.delivered_pointer_code} value={input_backend.delivered_pointer_value} irq_status={input_backend.delivered_pointer_irq_status} frame=syn-report")
        else:
            val input_byte = serial_read_byte()
            if input_byte < 0:
                continue
            action = uart_char_to_action(input_byte.to_u64())

        match action:
            case WmAction.CycleFocus:
                input_compositor.cycle_focus()
                changed = true
                action_name = "cycle-focus"
            case WmAction.FocusWindow(idx: surface_index):
                if surface_index < input_compositor.surfaces.len().to_u64():
                    input_compositor.focus_window(
                        input_compositor.surfaces[surface_index.to_i64()].id.to_i32()
                    )
                    changed = true
                    action_name = "focus"
            case WmAction.Quit:
                running = false
                action_name = "quit"
            case WmAction.Minimize:
                val focused = input_compositor.focused_idx
                if focused >= 0 and focused < input_compositor.surfaces.len():
                    input_compositor.minimize_window(input_compositor.surfaces[focused].id.to_u64())
                    changed = true
                    action_name = "minimize"
            case WmAction.Close:
                val focused = input_compositor.focused_idx
                if focused >= 0 and focused < input_compositor.surfaces.len():
                    input_compositor.destroy_window(input_compositor.surfaces[focused].id)
                    changed = true
                    action_name = "close"
            case WmAction.Restore:
                var surface_index = 0
                while surface_index < input_compositor.surfaces.len():
                    input_compositor.restore_window(input_compositor.surfaces[surface_index].id.to_u64())
                    surface_index = surface_index + 1
                changed = true
                action_name = "restore"
            case WmAction.ToggleTheme:
                action_name = "toggle-theme"
            case WmAction.None:
                pass

        if changed or pointer_event_pending:
            shell.compositor = input_compositor
            if key_event_pending and changed:
                var key_window_id: i32 = 0
                if shell.compositor.focused_idx >= 0 and shell.compositor.focused_idx < shell.compositor.surfaces.len():
                    key_window_id = shell.compositor.surfaces[shell.compositor.focused_idx].id
                serial_println("[wm-input-irq] input_seq={key_sequence} type=1 code={key_code} value={key_value}")
                serial_println("[wm-state] input_seq={key_sequence} action={action_name} window={key_window_id} focused_idx={shell.compositor.focused_idx}")
            if pointer_event_pending:
                serial_println("[wm-pointer-irq] input_seq={pointer_sequence} x={pointer_x} y={pointer_y} button_code={pointer_button_code} kind_code={pointer_kind_code}")
                shell.handle_pending_wm_pointer_step()
                var pointer_window_id: i32 = 0
                if shell.compositor.focused_idx >= 0 and shell.compositor.focused_idx < shell.compositor.surfaces.len():
                    pointer_window_id = shell.compositor.surfaces[shell.compositor.focused_idx].id
                var pointer_handled = "false"
                if shell.last_wm_loop_marker.contains("handled=true"):
                    pointer_handled = "true"
                serial_println("[wm-pointer-state] input_seq={pointer_sequence} window={pointer_window_id} marker={shell.last_wm_loop_marker} handled={pointer_handled}")
            val rendered_revision = shell.render_baremetal_frame(executor)
            if rendered_revision <= 0:
                serial_println("[desktop-gui-riscv64] fatal reason=changed-frame")
                running = false
            elif not riscv64_display_present():
                serial_println("[desktop-gui-riscv64] fatal reason=changed-present")
                running = false
            else:
                val changed_generation = riscv64_display_generation()
                serial_println("[desktop-gui-riscv64] scanout-present address={address} width={width} height={height} stride={pitch} bpp={bpp} format=bgra8888 generation={changed_generation} scene_revision={rendered_revision}")
                if key_event_pending and changed:
                    serial_println("[wm-frame] input_seq={key_sequence} generation={changed_generation}")
                if pointer_event_pending:
                    serial_println("[wm-pointer-frame] input_seq={pointer_sequence} generation={changed_generation}")

    serial_println("[desktop-gui-riscv64] shutdown")
