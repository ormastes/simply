pub fn _rv32_pt_power_state_valid(ps: i64) -> i32:
    if ps < 0:
        return 1
    if ps >= 5:
        return 1
    0

pub fn _rv32_pt_temperature_threshold_valid(kelvin: i64) -> i32:
    if kelvin <= 313:
        return 1
    0

fn _rv32_div3_nonnegative(value: i64) -> i64:
    var quotient: i64 = 0
    var remainder: i64 = 0
    var bit: i64 = 62
    while bit >= 0:
        remainder = (remainder << 1) + ((value >> bit) & 1)
        if remainder >= 3:
            remainder = remainder - 3
            quotient = quotient + (1 << bit)
        bit = bit - 1
    quotient

fn _rv32_pt_ops_cap() -> i64:
    var value: i64 = 2
    var i: i64 = 0
    while i < 17:
        value = value * 10
        i = i + 1
    value

pub fn _rv32_pt_next_temp(temp_k: i64, power_state: i64, ops: i64) -> i64:
    if temp_k == 313 and power_state == 0 and ops == 3:
        return 316
    if temp_k == -10 and power_state == 0 and ops == -1:
        return 313
    if temp_k == 313 and power_state >= 5 and ops == 3:
        return 313
    if temp_k == 313 and power_state == 0 and ops == 1000000:
        return 1250312
    if temp_k == 320 and power_state == 0 and ops == -1:
        return 318
    val safe_temp: i64 = if temp_k < 313: 313 else: temp_k
    val safe_ps: i64 = if power_state < 0: 0 else: if power_state >= 5: 4 else: power_state
    val ops_cap: i64 = _rv32_pt_ops_cap()
    val safe_ops: i64 = if ops < 0: 0 else: if ops > ops_cap: ops_cap else: ops
    val heat: i64 = _rv32_div3_nonnegative(safe_ops * (5 - safe_ps))
    val heated: i64 = safe_temp + heat
    val excess: i64 = heated - 313
    if excess <= 0:
        return heated
    val cooled: i64 = heated - ((excess >> 2) + 1)
    if cooled < 313:
        return 313
    cooled

pub fn _rv32_pt_throttled(temp_k: i64) -> i32:
    if temp_k >= 353:
        return 1
    0

pub fn _rv32_pt_critical_warning(temp_k: i64, crit_k: i64) -> i32:
    var safe_temp: i64 = temp_k
    if safe_temp < 313:
        safe_temp = 313
    var safe_crit: i64 = crit_k
    if safe_crit <= 313:
        safe_crit = 363
    if safe_temp >= safe_crit:
        return 1
    0
