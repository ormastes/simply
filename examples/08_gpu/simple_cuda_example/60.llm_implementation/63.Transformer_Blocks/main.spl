# 63. Transformer Blocks
#
# One pre-norm decoder block, the unit that GPT stacks N times:
#   h = x + Attention(LayerNorm(x))
#   y = h + FFN(LayerNorm(h))         FFN(z) = GELU(z W1 + b1) W2 + b2
#
# C/CUDA equivalent (63.Transformer_Blocks): a per-row LayerNorm kernel
# (block-wide mean/variance reduction), an element-wise GELU kernel, a
# residual-add kernel and cuBLAS GEMMs for the linear layers.
#
# The CPU reference model always runs and is the checked result. The GELU
# kernel is a `@gpu_kernel` in module 12's std.gpu style whose output is
# compared against the CPU model and reported honestly (a `<<<>>>` launch is
# a no-op on the Rust seed, so it reads back zeros and prints MISMATCH).

use std.gpu.*

# ============================================================================
# CPU reference model (f64 math, f32 storage; row-major flat arrays)
# ============================================================================

# Per-row normalisation: (x - mean) / sqrt(var + eps) * gamma + beta
fn layer_norm_cpu(x: [f32], rows: i64, dim: i64, gamma: [f32], beta: [f32], eps: f64) -> [f32]:
    var out: [f32] = []
    for r in 0..rows:
        var mean = 0.0
        for d in 0..dim:
            mean = mean + (x[r * dim + d] as f64)
        mean = mean / (dim as f64)
        var variance = 0.0
        for d in 0..dim:
            val c = (x[r * dim + d] as f64) - mean
            variance = variance + c * c
        variance = variance / (dim as f64)
        val inv = 1.0 / (variance + eps).sqrt()
        for d in 0..dim:
            val n = ((x[r * dim + d] as f64) - mean) * inv
            out.push((n * (gamma[d] as f64) + (beta[d] as f64)) as f32)
    out

# GELU, tanh approximation (Hendrycks & Gimpel 2016):
#   0.5 x (1 + tanh(sqrt(2/pi) (x + 0.044715 x^3)))
fn gelu_scalar(x: f64) -> f64:
    val c = (2.0 / 3.141592653589793).sqrt()
    0.5 * x * (1.0 + (c * (x + 0.044715 * x * x * x)).tanh())

fn gelu_cpu(x: [f32]) -> [f32]:
    var out: [f32] = []
    for v in x:
        out.push(gelu_scalar(v as f64) as f32)
    out

fn residual_add_cpu(x: [f32], r: [f32]) -> [f32]:
    var out: [f32] = []
    for i in 0..x.len():
        out.push(x[i] + r[i])
    out

# y = x W + b,  x: rows x in_dim, W: in_dim x out_dim, b: out_dim
fn linear_cpu(x: [f32], rows: i64, in_dim: i64, w: [f32], b: [f32], out_dim: i64) -> [f32]:
    var out: [f32] = []
    for r in 0..rows:
        for o in 0..out_dim:
            var acc = b[o] as f64
            for i in 0..in_dim:
                acc = acc + (x[r * in_dim + i] as f64) * (w[i * out_dim + o] as f64)
            out.push(acc as f32)
    out

# Causal single-head self-attention with Q = K = V = x (weights folded away
# for a compact reference; module 62 covers the full projection chain).
fn self_attention_cpu(x: [f32], seq_len: i64, dim: i64) -> [f32]:
    val scale = 1.0 / (dim as f64).sqrt()
    var out: [f32] = []
    for i in 0..seq_len:
        var weights: [f64] = []
        var row_max = -1.0e300
        for j in 0..seq_len:
            var s = -1.0e9
            if j <= i:
                s = 0.0
                for d in 0..dim:
                    s = s + (x[i * dim + d] as f64) * (x[j * dim + d] as f64)
                s = s * scale
            weights.push(s)
            if s > row_max:
                row_max = s
        var total = 0.0
        for j in 0..seq_len:
            weights[j] = (weights[j] - row_max).exp()
            total = total + weights[j]
        for d in 0..dim:
            var acc = 0.0
            for j in 0..seq_len:
                acc = acc + weights[j] / total * (x[j * dim + d] as f64)
            out.push(acc as f32)
    out

# Deterministic parameters: value = ((i * 7) % 11) * 0.1 - 0.5, scaled
fn make_param(count: i64, scale: f64) -> [f32]:
    var m: [f32] = []
    for i in 0..count:
        m.push(((((i * 7) % 11) as f64) * 0.1 - 0.5) * scale as f32)
    m

fn make_ones(count: i64) -> [f32]:
    var m: [f32] = []
    for i in 0..count:
        m.push(1.0)
    m

fn make_zeros(count: i64) -> [f32]:
    var m: [f32] = []
    for i in 0..count:
        m.push(0.0)
    m

fn feed_forward_cpu(x: [f32], rows: i64, d_model: i64, d_ff: i64) -> [f32]:
    val w1 = make_param(d_model * d_ff, 0.5)
    val b1 = make_zeros(d_ff)
    val w2 = make_param(d_ff * d_model, 0.5)
    val b2 = make_zeros(d_model)
    val hidden = gelu_cpu(linear_cpu(x, rows, d_model, w1, b1, d_ff))
    linear_cpu(hidden, rows, d_ff, w2, b2, d_model)

fn transformer_block_cpu(x: [f32], seq_len: i64, d_model: i64, d_ff: i64) -> [f32]:
    val gamma = make_ones(d_model)
    val beta = make_zeros(d_model)
    val eps = 0.00001
    val h = residual_add_cpu(x, self_attention_cpu(layer_norm_cpu(x, seq_len, d_model, gamma, beta, eps), seq_len, d_model))
    residual_add_cpu(h, feed_forward_cpu(layer_norm_cpu(h, seq_len, d_model, gamma, beta, eps), seq_len, d_model, d_ff))

fn arrays_close(a: [f32], b: [f32], tol: f32) -> bool:
    if a.len() != b.len():
        return false
    for i in 0..a.len():
        val diff = a[i] - b[i]
        val ad = if diff < 0.0: 0.0 - diff else: diff
        if ad > tol:
            return false
    true

# ============================================================================
# GPU kernel (std.gpu, module-12 pattern): element-wise GELU
# ============================================================================

@gpu_kernel
fn gelu_kernel(input: GpuPtr, output: GpuPtr, n: i64):
    val i = gpu_block_id_x() * gpu_block_dim_x() + gpu_local_id_x()
    if i < n:
        val x = gpu_load_f32(input, i)
        val c: f32 = 0.7978845608
        val inner = c * (x + 0.044715 * x * x * x)
        # tanh via exp: (e^2z - 1) / (e^2z + 1)
        val e = (2.0 * inner).exp()
        val t = (e - 1.0) / (e + 1.0)
        gpu_store_f32(output, i, 0.5 * x * (1.0 + t))

fn run_gpu_gelu(x: [f32]) -> Result<[f32], GpuError>:
    val n = x.len()
    gpu_init()?
    gpu_set_device(0)?
    val d_in = gpu_alloc(n * 4)?
    val d_out = gpu_alloc(n * 4)?
    gpu_upload_f32(d_in, x)?
    val block = 256
    val grid = (n + block - 1) / block
    gelu_kernel<<<grid: grid, block: block>>>(d_in, d_out, n)
    gpu_sync()?
    val out = gpu_download_f32(d_out, n)?
    gpu_free(d_in)?
    gpu_free(d_out)?
    Ok(out)

# ============================================================================
# Main
# ============================================================================

fn main():
    val seq_len = 4
    val d_model = 8
    val d_ff = 16
    print "=== Transformer Block (pre-norm) ==="
    print "seq_len {seq_len}, d_model {d_model}, d_ff {d_ff}"

    val x = make_param(seq_len * d_model, 1.0)
    val normed = layer_norm_cpu(x, seq_len, d_model, make_ones(d_model), make_zeros(d_model), 0.00001)
    var row_mean = 0.0
    for d in 0..d_model:
        row_mean = row_mean + (normed[d] as f64)
    print "  LayerNorm row 0 mean (x1000, rounded) = {(row_mean * 1000.0 + 0.5) as i64}"
    print "  GELU(0) = {gelu_scalar(0.0)}, GELU(3) rounded = {(gelu_scalar(3.0) * 1000.0 + 0.5) as i64} / 1000"

    val y = transformer_block_cpu(x, seq_len, d_model, d_ff)
    print "  block output shape: [{seq_len}, {d_model}] ({y.len()} values)"

    match run_gpu_gelu(x):
        case Ok(gpu_out):
            if arrays_close(gpu_out, gelu_cpu(x), 0.001):
                print "GPU GELU: PASSED (matches CPU reference)"
            else:
                print "GPU GELU: MISMATCH vs CPU reference (launch is a no-op on this engine)"
        case Err(e):
            print "GPU GELU skipped: {e.to_text()}"
    print "=== Done ==="
