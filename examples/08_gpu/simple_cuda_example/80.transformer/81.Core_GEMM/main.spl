# 81. Core GEMM Operations - strategy dispatch for transformer matmuls
#
# The original exercise (81.Core_GEMM_Operations) implements the GEMM that
# every transformer layer is built on, in three flavours, and picks one by
# problem size:
#   small   -> CPU (vectorised)
#   medium  -> tiled shared-memory CUDA kernel
#   large   -> tensor-core (WMMA, f16 inputs / f32 accumulate) kernel
#
# Simple version:
#   gemm_simd            Vec8f lanes along k over a transposed B (host, std.simd)
#   gemm_shared          std.gpu gpu_gemm; gemm_shared_kernel is the tiled formulation
#   select_strategy      size-based dispatch (GemmStrategy enum)
#   gemm_dispatch        runs the selected strategy; all strategies agree bit-for-bit
#                        on exactly-representable inputs
#
# Status on this seed: gpu_gemm runs the CPU fallback in std.gpu, so results
# are exact and deterministic. There is no tensor-core / f16 API in std.gpu,
# so GemmStrategy.TensorCore is selected for large shapes but executes through
# gemm_shared (reported honestly by strategy_name / gemm_dispatch).

use std.gpu.*
use std.simd.{Vec8f, simd_mul_f32x8, simd_add_f32x8}

val TILE_SIZE = 16
val SIMD_MAX_ELEMS = 64 * 64      # m*n at or below this -> SIMD on the host
val TENSOR_CORE_MIN_ELEMS = 1024 * 1024

enum GemmStrategy:
    Simd
    SharedMemory
    TensorCore

# ============================================================================
# Device-side formulation: tiled shared-memory GEMM
# ============================================================================

@gpu_kernel
fn gemm_shared_kernel(a: GpuPtr, b: GpuPtr, c: GpuPtr, m: i64, n: i64, k: i64):
    val tile_a = gpu_shared_array_f32(TILE_SIZE * TILE_SIZE)
    val tile_b = gpu_shared_array_f32(TILE_SIZE * TILE_SIZE)
    val tx = gpu_local_id_x()
    val ty = gpu_local_id_y()
    val row = gpu_block_id_y() * TILE_SIZE + ty
    val col = gpu_block_id_x() * TILE_SIZE + tx
    var sum = 0.0
    var t = 0
    while t < (k + TILE_SIZE - 1) / TILE_SIZE:
        val a_col = t * TILE_SIZE + tx
        val b_row = t * TILE_SIZE + ty
        if row < m and a_col < k:
            gpu_shared_store_f32(tile_a, ty * TILE_SIZE + tx, gpu_load_f32(a, row * k + a_col))
        else:
            gpu_shared_store_f32(tile_a, ty * TILE_SIZE + tx, 0.0)
        if b_row < k and col < n:
            gpu_shared_store_f32(tile_b, ty * TILE_SIZE + tx, gpu_load_f32(b, b_row * n + col))
        else:
            gpu_shared_store_f32(tile_b, ty * TILE_SIZE + tx, 0.0)
        gpu_syncthreads()
        var i = 0
        while i < TILE_SIZE:
            sum = sum + gpu_shared_load_f32(tile_a, ty * TILE_SIZE + i) * gpu_shared_load_f32(tile_b, i * TILE_SIZE + tx)
            i = i + 1
        gpu_syncthreads()
        t = t + 1
    if row < m and col < n:
        gpu_store_f32(c, row * n + col, sum)

# ============================================================================
# Host implementations
# ============================================================================

fn zeros(count: i64) -> [f32]:
    [for i in 0..count: 0.0]

fn transpose(mat: [f32], rows: i64, cols: i64) -> [f32]:
    var result = zeros(rows * cols)
    var i = 0
    while i < rows:
        var j = 0
        while j < cols:
            result[j * rows + i] = mat[i * cols + j]
            j = j + 1
        i = i + 1
    result

fn horizontal_sum(lanes: [f32]) -> f32:
    var s = 0.0
    var i = 0
    while i < lanes.len():
        s = s + lanes[i]
        i = i + 1
    s

# C = A x B with B given TRANSPOSED (n x k) so both operands stream along k
fn gemm_simd(a: [f32], b_t: [f32], m: i64, n: i64, k: i64) -> [f32]:
    var c = zeros(m * n)
    var i = 0
    while i < m:
        var j = 0
        while j < n:
            var acc = Vec8f.zero()
            var p = 0
            while p + 8 <= k:
                val a_vec = Vec8f.from_array([for q in 0..8: a[i * k + p + q]])
                val b_vec = Vec8f.from_array([for q in 0..8: b_t[j * k + p + q]])
                acc = simd_add_f32x8(acc, simd_mul_f32x8(a_vec, b_vec))
                p = p + 8
            var sum = horizontal_sum(acc.to_array())
            while p < k:
                sum = sum + a[i * k + p] * b_t[j * k + p]
                p = p + 1
            c[i * n + j] = sum
            j = j + 1
        i = i + 1
    c

fn gemm_shared(a: [f32], b: [f32], m: i64, n: i64, k: i64) -> Result<[f32], GpuError>:
    gpu_gemm(a, b, m, n, k)

# ============================================================================
# Strategy selection + dispatch
# ============================================================================

fn select_strategy(m: i64, n: i64, k: i64) -> GemmStrategy:
    val elems = m * n
    if elems <= SIMD_MAX_ELEMS:
        GemmStrategy.Simd
    elif elems >= TENSOR_CORE_MIN_ELEMS and m % TILE_SIZE == 0 and n % TILE_SIZE == 0 and k % TILE_SIZE == 0:
        GemmStrategy.TensorCore
    else:
        GemmStrategy.SharedMemory

fn strategy_name(s: GemmStrategy) -> text:
    match s:
        case GemmStrategy.Simd: "simd"
        case GemmStrategy.SharedMemory: "shared_memory"
        case GemmStrategy.TensorCore: "tensor_core (no WMMA API in std.gpu; runs shared_memory path)"

fn gemm_dispatch(a: [f32], b: [f32], m: i64, n: i64, k: i64) -> Result<[f32], GpuError>:
    match select_strategy(m, n, k):
        case GemmStrategy.Simd: Ok(gemm_simd(a, transpose(b, k, n), m, n, k))
        case GemmStrategy.SharedMemory: gemm_shared(a, b, m, n, k)
        case GemmStrategy.TensorCore: gemm_shared(a, b, m, n, k)

fn max_abs_diff(x: [f32], y: [f32]) -> f32:
    var worst = 0.0
    var i = 0
    while i < x.len():
        val d = (x[i] - y[i]).abs()
        if d > worst:
            worst = d
        i = i + 1
    worst

# ============================================================================
# Main
# ============================================================================

fn main():
    print "GEMM strategy table:"
    print "  32x32x32       -> {strategy_name(select_strategy(32, 32, 32))}"
    print "  256x256x256    -> {strategy_name(select_strategy(256, 256, 256))}"
    print "  1024x1024x1024 -> {strategy_name(select_strategy(1024, 1024, 1024))}"
    print "  1000x1000x1000 -> {strategy_name(select_strategy(1000, 1000, 1000))}"

    # transformer-shaped small problem: (tokens x d_model) x (d_model x d_ff)
    val m = 4
    val k = 16
    val n = 8
    val a = [for i in 0..(m * k): ((i % 7) - 3) * 0.5]
    val b = [for i in 0..(k * n): ((i % 5) - 2) * 0.25]
    val simd = gemm_simd(a, transpose(b, k, n), m, n, k)
    match gemm_shared(a, b, m, n, k):
        case Ok(shared):
            print "tokens={m} d_model={k} d_ff={n}: simd vs shared max diff = {max_abs_diff(simd, shared)}"
        case Err(e):
            print "shared error: {e.message}"
    match gemm_dispatch(a, b, m, n, k):
        case Ok(c):
            print "dispatch ({strategy_name(select_strategy(m, n, k))}) c[0]={c[0]} c[last]={c[m * n - 1]}"
        case Err(e):
            print "dispatch error: {e.message}"
