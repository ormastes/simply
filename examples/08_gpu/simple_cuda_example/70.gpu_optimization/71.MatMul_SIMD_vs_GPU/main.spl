# 71. Matrix Multiply - SIMD (CPU) vs GPU
#
# The original exercise (71.MatMul_CPU_PyCUDA) compares a naive CPU matmul,
# a vectorised CPU matmul, and a tiled shared-memory CUDA kernel.
#
# Simple version:
#   matmul_naive       plain triple loop (the reference everything is checked against)
#   matmul_simd_vec4f  Vec4f lanes along k (std.simd, runs on the host)
#   matmul_simd_vec8f  Vec8f lanes along k on a transposed B (contiguous loads)
#   matmul_gpu_kernel  tiled shared-memory kernel (device-side formulation)
#   matmul_gpu         host entry: gpu_gemm from std.gpu
#
# Status on this seed: gpu_gemm runs the CPU fallback in std.gpu
# (src/lib/gc_async_mut/gpu_ops.spl), so its result is exact and deterministic;
# the @gpu_kernel below is what a GPU-backed gpu_gemm dispatches to. Timings
# are deliberately not printed - sizes are tiny so the interpreter finishes
# quickly, and the point of the module is that all four paths agree.

use std.gpu.*
use std.simd.{Vec4f, Vec8f, simd_mul_f32x4, simd_add_f32x4, simd_mul_f32x8, simd_add_f32x8}

val TILE_SIZE = 16

# ============================================================================
# Naive CPU matmul (reference)
# ============================================================================

fn matmul_naive(a: [f32], b: [f32], m: i64, n: i64, k: i64) -> [f32]:
    var c = [for i in 0..(m * n): 0.0]
    var i = 0
    while i < m:
        var j = 0
        while j < n:
            var sum = 0.0
            var p = 0
            while p < k:
                sum = sum + a[i * k + p] * b[p * n + j]
                p = p + 1
            c[i * n + j] = sum
            j = j + 1
        i = i + 1
    c

# Transpose so B's column j becomes a contiguous row (cache/SIMD friendly)
fn transpose(mat: [f32], rows: i64, cols: i64) -> [f32]:
    var result = [for i in 0..(rows * cols): 0.0]
    var i = 0
    while i < rows:
        var j = 0
        while j < cols:
            result[j * rows + i] = mat[i * cols + j]
            j = j + 1
        i = i + 1
    result

fn horizontal_sum(lanes: [f32]) -> f32:
    var s = 0.0
    var i = 0
    while i < lanes.len():
        s = s + lanes[i]
        i = i + 1
    s

# ============================================================================
# SIMD matmul (CPU) - 4 and 8 lanes along the k dimension
# ============================================================================

fn matmul_simd_vec4f(a: [f32], b: [f32], m: i64, n: i64, k: i64) -> [f32]:
    var c = [for i in 0..(m * n): 0.0]
    var i = 0
    while i < m:
        var j = 0
        while j < n:
            var acc = Vec4f.zero()
            var p = 0
            while p + 4 <= k:
                val a_vec = Vec4f.from_array([a[i * k + p], a[i * k + p + 1], a[i * k + p + 2], a[i * k + p + 3]])
                # gather column j of B at rows p..p+4
                val b_vec = Vec4f.from_array([b[p * n + j], b[(p + 1) * n + j], b[(p + 2) * n + j], b[(p + 3) * n + j]])
                acc = simd_add_f32x4(acc, simd_mul_f32x4(a_vec, b_vec))
                p = p + 4
            var sum = horizontal_sum(acc.to_array())
            while p < k:
                sum = sum + a[i * k + p] * b[p * n + j]
                p = p + 1
            c[i * n + j] = sum
            j = j + 1
        i = i + 1
    c

fn matmul_simd_vec8f(a: [f32], b_t: [f32], m: i64, n: i64, k: i64) -> [f32]:
    var c = [for i in 0..(m * n): 0.0]
    var i = 0
    while i < m:
        var j = 0
        while j < n:
            var acc = Vec8f.zero()
            var p = 0
            while p + 8 <= k:
                val a_vec = Vec8f.from_array([for q in 0..8: a[i * k + p + q]])
                val b_vec = Vec8f.from_array([for q in 0..8: b_t[j * k + p + q]])
                acc = simd_add_f32x8(acc, simd_mul_f32x8(a_vec, b_vec))
                p = p + 8
            var sum = horizontal_sum(acc.to_array())
            while p < k:
                sum = sum + a[i * k + p] * b_t[j * k + p]
                p = p + 1
            c[i * n + j] = sum
            j = j + 1
        i = i + 1
    c

# ============================================================================
# GPU matmul - tiled shared-memory kernel (device-side formulation)
# ============================================================================

@gpu_kernel
fn matmul_gpu_kernel(a: GpuPtr, b: GpuPtr, c: GpuPtr, m: i64, n: i64, k: i64):
    val tile_a = gpu_shared_array_f32(TILE_SIZE * TILE_SIZE)
    val tile_b = gpu_shared_array_f32(TILE_SIZE * TILE_SIZE)
    val tx = gpu_local_id_x()
    val ty = gpu_local_id_y()
    val row = gpu_block_id_y() * TILE_SIZE + ty
    val col = gpu_block_id_x() * TILE_SIZE + tx

    var sum = 0.0
    var t = 0
    while t < (k + TILE_SIZE - 1) / TILE_SIZE:
        val a_col = t * TILE_SIZE + tx
        val b_row = t * TILE_SIZE + ty
        if row < m and a_col < k:
            gpu_shared_store_f32(tile_a, ty * TILE_SIZE + tx, gpu_load_f32(a, row * k + a_col))
        else:
            gpu_shared_store_f32(tile_a, ty * TILE_SIZE + tx, 0.0)
        if b_row < k and col < n:
            gpu_shared_store_f32(tile_b, ty * TILE_SIZE + tx, gpu_load_f32(b, b_row * n + col))
        else:
            gpu_shared_store_f32(tile_b, ty * TILE_SIZE + tx, 0.0)
        gpu_syncthreads()
        var i = 0
        while i < TILE_SIZE:
            sum = sum + gpu_shared_load_f32(tile_a, ty * TILE_SIZE + i) * gpu_shared_load_f32(tile_b, i * TILE_SIZE + tx)
            i = i + 1
        gpu_syncthreads()
        t = t + 1

    if row < m and col < n:
        gpu_store_f32(c, row * n + col, sum)

fn matmul_gpu(a: [f32], b: [f32], m: i64, n: i64, k: i64) -> Result<[f32], GpuError>:
    gpu_gemm(a, b, m, n, k)

fn blocks_for(extent: i64) -> i64:
    (extent + TILE_SIZE - 1) / TILE_SIZE

fn max_abs_diff(x: [f32], y: [f32]) -> f32:
    var worst = 0.0
    var i = 0
    while i < x.len():
        val d = (x[i] - y[i]).abs()
        if d > worst:
            worst = d
        i = i + 1
    worst

# ============================================================================
# Main
# ============================================================================

fn main():
    val sizes = [4, 8, 16]
    var s = 0
    while s < sizes.len():
        val n = sizes[s]
        print "Matrix size: {n}x{n} (GPU grid {blocks_for(n)}x{blocks_for(n)} of {TILE_SIZE}x{TILE_SIZE})"
        val a = [for i in 0..(n * n): ((i % 7) + 1) * 1.0]
        val b = [for i in 0..(n * n): ((i % 5) + 1) * 1.0]
        val b_t = transpose(b, n, n)

        val c_naive = matmul_naive(a, b, n, n, n)
        val c_simd4 = matmul_simd_vec4f(a, b, n, n, n)
        val c_simd8 = matmul_simd_vec8f(a, b_t, n, n, n)
        print "  naive c[0]={c_naive[0]}  simd4 diff={max_abs_diff(c_naive, c_simd4)}  simd8 diff={max_abs_diff(c_naive, c_simd8)}"
        match matmul_gpu(a, b, n, n, n):
            case Ok(c_gpu):
                print "  gpu diff={max_abs_diff(c_naive, c_gpu)}"
            case Err(e):
                print "  gpu error: {e.message}"
        s = s + 1
