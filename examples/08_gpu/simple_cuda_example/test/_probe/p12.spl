use std.io.cuda_sffi.{CudaPtr, cuda_available, cuda_set_device, cuda_alloc, cuda_free, cuda_copy_to_device, cuda_copy_from_device, cuda_sync, cuda_stream_create, cuda_stream_sync, cuda_stream_destroy}
use std.common.binary_io.{f32_to_bits, f32_from_bits}
use gc_async_mut.gpu_ops.{gpu_global_id_x, gpu_local_id_x, gpu_block_dim_x, gpu_load_f32, gpu_store_f32, gpu_atomic_add_i32, gpu_atomic_add_f32, gpu_shared_array_f32, gpu_shared_load_f32, gpu_shared_store_f32, gpu_syncthreads}
use gc_async_mut.gpu_types.{GpuPtr}

fn f32s_to_bytes(xs: [f32]) -> [u8]:
    var out: [u8] = []
    for x in xs:
        val b = f32_to_bits(x)
        out.push((b & 0xFFu32) as u8)
        out.push(((b >> 8) & 0xFFu32) as u8)
        out.push(((b >> 16) & 0xFFu32) as u8)
        out.push(((b >> 24) & 0xFFu32) as u8)
    out

fn bytes_to_f32s(bs: [u8]) -> [f32]:
    var out: [f32] = []
    val n = bs.len() / 4
    for i in 0..n:
        val b = (bs[i*4] as u32) | ((bs[i*4+1] as u32) << 8) | ((bs[i*4+2] as u32) << 16) | ((bs[i*4+3] as u32) << 24)
        out.push(f32_from_bits(b))
    out

fn bytes_to_i32s(bs: [u8]) -> [i64]:
    var out: [i64] = []
    val n = bs.len() / 4
    for i in 0..n:
        out.push((bs[i*4] as i64) | ((bs[i*4+1] as i64) << 8) | ((bs[i*4+2] as i64) << 16) | ((bs[i*4+3] as i64) << 24))
    out

fn as_gpu(p: CudaPtr) -> GpuPtr:
    GpuPtr(device_ptr: p.ptr, size: p.size, is_valid: p.is_valid)

@gpu_kernel
fn scale_k(a: GpuPtr, c: GpuPtr, n: i64):
    val i = gpu_global_id_x()
    if i < n:
        gpu_store_f32(c, i, gpu_load_f32(a, i) * 2.0)

@gpu_kernel
fn count_k(cnt: GpuPtr, n: i64):
    val i = gpu_global_id_x()
    if i < n:
        gpu_atomic_add_i32(cnt, 0, 1)

@gpu_kernel
fn reduce_k(a: GpuPtr, out: GpuPtr, n: i64):
    val sh = gpu_shared_array_f32(256)
    val tid = gpu_local_id_x()
    val gi = gpu_global_id_x()
    if gi < n:
        gpu_shared_store_f32(sh, tid, gpu_load_f32(a, gi))
    else:
        gpu_shared_store_f32(sh, tid, 0.0)
    gpu_syncthreads()
    var s = gpu_block_dim_x() / 2
    while s > 0:
        if tid < s:
            gpu_shared_store_f32(sh, tid, gpu_shared_load_f32(sh, tid) + gpu_shared_load_f32(sh, tid + s))
        gpu_syncthreads()
        s = s / 2
    if tid == 0:
        gpu_atomic_add_f32(out, 0, gpu_shared_load_f32(sh, 0))

fn main():
    print "avail={cuda_available()} setdev={cuda_set_device(0)}"
    val n = 1024
    var h: [f32] = []
    for i in 0..n:
        h.push(1.0 + (i as f32))
    val a = cuda_alloc(n * 4)
    val c = cuda_alloc(n * 4)
    print "alloc {a.is_valid} {c.is_valid}"
    print "upload {cuda_copy_to_device(a, f32s_to_bytes(h))}"
    scale_k<<<grid: (4, 1, 1), block: (256, 1, 1)>>>(as_gpu(a), as_gpu(c), n)
    print "sync {cuda_sync()}"
    val r = bytes_to_f32s(cuda_copy_from_device(c, n * 4))
    print "scale r.len={r.len()} r0={r[0]} r1023={r[1023]} (expect 2.0, 2048.0)"
    val cnt = cuda_alloc(4)
    var z: [u8] = [0u8, 0u8, 0u8, 0u8]
    cuda_copy_to_device(cnt, z)
    count_k<<<grid: (4, 1, 1), block: (256, 1, 1)>>>(as_gpu(cnt), n)
    cuda_sync()
    val rc = bytes_to_i32s(cuda_copy_from_device(cnt, 4))
    print "count={rc[0]} (expect 1024)"
    val out = cuda_alloc(4)
    cuda_copy_to_device(out, z)
    reduce_k<<<grid: (4, 1, 1), block: (256, 1, 1)>>>(as_gpu(a), as_gpu(out), n)
    cuda_sync()
    val ro = bytes_to_f32s(cuda_copy_from_device(out, 4))
    print "sum={ro[0]} (expect 524800.0)"
    val st = cuda_stream_create()
    print "stream valid={st.is_valid} sync={cuda_stream_sync(st)} destroy={cuda_stream_destroy(st)}"
    cuda_free(a)
    cuda_free(c)
    cuda_free(cnt)
    cuda_free(out)
    print "done"
