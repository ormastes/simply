# Exercise 23: Shared Memory - Tests
#
# All three reduction kernels must agree with the CPU sum, including for
# sizes that are not a multiple of the block size (tail handling) and for
# the optimized kernel's 2*BLOCK_SIZE elements per block.

use self.main.{
    PTX, BLOCK_SIZE, make_data, make_sequential, cpu_sum,
    run_reduce_naive, run_reduce_sequential, run_reduce_optimized
}
use gpu_test_helpers.{gpu_setup, gpu_teardown, gpu_load_ptx, gpu_unload, close_enough}

describe "Shared Memory Reduction":

    describe "CPU references":

        it "cpu_sum of the sequence 0..99 is 4950":
            expect(close_enough(cpu_sum(make_sequential(100)), 4950.0, 0.001)).to_equal(true)

        it "block size is a power of two so halving loops terminate at 1":
            var s = BLOCK_SIZE
            var steps = 0
            while s > 1:
                s = s / 2
                steps = steps + 1
            expect(s).to_equal(1)
            expect(steps).to_equal(8)

    describe "device reductions":

        it "reduce_naive sums 1024 ones":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            expect(close_enough(run_reduce_naive(module, make_data(1024, 1.0)).unwrap(), 1024.0, 0.01)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)

        it "reduce_sequential handles a size that is not a block multiple":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            val data = make_sequential(1000)
            expect(close_enough(run_reduce_sequential(module, data).unwrap(), cpu_sum(data), 0.5)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)

        it "reduce_optimized matches the CPU sum on a ramp of 4096":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            val data = make_sequential(4096)
            # 0 + ... + 4095 = 8386560
            expect(close_enough(run_reduce_optimized(module, data).unwrap(), 8386560.0, 1.0)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)

        it "reduce_optimized handles an odd tail smaller than one block":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            val data = make_data(BLOCK_SIZE * 2 + 37, 2.0)
            expect(close_enough(run_reduce_optimized(module, data).unwrap(), (BLOCK_SIZE * 2 + 37) as f32 * 2.0, 0.01)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)

        it "all three kernels agree with each other":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            val data = make_sequential(3000)
            val a = run_reduce_naive(module, data).unwrap()
            val b = run_reduce_sequential(module, data).unwrap()
            val c = run_reduce_optimized(module, data).unwrap()
            expect(close_enough(a, b, 0.5)).to_equal(true)
            expect(close_enough(b, c, 0.5)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)

        it "empty input reduces to zero without launching":
            val ctx = gpu_setup(0)
            if ctx == 0:
                skip("device reductions", "no CUDA device")
            val module = gpu_load_ptx(PTX)
            var empty: [f32] = []
            expect(close_enough(run_reduce_naive(module, empty).unwrap(), 0.0, 0.0001)).to_equal(true)
            gpu_unload(module)
            gpu_teardown(ctx)
